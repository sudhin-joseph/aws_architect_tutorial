{
  "scope": "offline-model-only",
  "customer_vpc": "10.60.0.0/16",
  "aws_vpc": "10.80.0.0/16",
  "customer_subnet": "10.60.10.0/24",
  "aws_subnet": "10.80.20.0/24",
  "customer_host": "10.60.10.20",
  "aws_host": "10.80.20.10",
  "customer_routes": [
    {"destination": "10.60.0.0/16", "target": "local"},
    {"destination": "10.80.0.0/16", "target": "appliance"}
  ],
  "aws_routes": [
    {"destination": "10.80.0.0/16", "target": "local"},
    {"destination": "10.60.0.0/16", "target": "vgw"}
  ],
  "appliance": {"ip_forward": true, "source_dest_check": false, "snat_inner_traffic": false},
  "tunnels": [
    {"name": "aws1", "configured": true},
    {"name": "aws2", "configured": true}
  ],
  "test_mode": "one-tunnel-at-a-time-manual-recovery",
  "capacity": {"critical_mbps": 360, "bulk_mbps": 540, "backup_mbps": 600, "pause_bulk_on_failover": true}
}
